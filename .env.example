# Raiz dos dados persistentes (PostgreSQL, RF, etc.)
PROSPECT_DATA_ROOT=C:/prospect-portal-data

# Tunnel Cloudflare (MIRA em search.aerosuite.app)
# PUBLIC_BASE_URL=https://search.aerosuite.app
# CORS_ALLOWED_ORIGINS=http://localhost:4201,https://search.aerosuite.app,https://search.aerosuite.com.br

# SMTP Gmail / Google Workspace (mesmas credenciais do AeroSuite — senha de app, nunca commitar)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=contato@aerosuite.com.br
SPRING_MAIL_PASSWORD=sua_senha_de_app_google_aqui
APP_MAIL_FROM=noreply@aerosuite.com.br
APP_MAIL_FROM_NAME=Aero Suite
APP_MAIL_SUPPORT=contato@aerosuite.com.br

# Evolution API (WhatsApp)
# Dev local: docker compose -f docker-compose.yml -f docker-compose.evolution.yml up -d
# Produção (mesmo host Aero Suite): NÃO suba Evolution aqui — use .env.production.example
#   APP_EVOLUTION_API_BASE_URL=http://127.0.0.1:18082
#   APP_EVOLUTION_INSTANCE=aerosuite-default
APP_EVOLUTION_ENABLED=false
APP_EVOLUTION_API_BASE_URL=http://localhost:18082
APP_EVOLUTION_API_KEY=aerosuite-evolution-api-key-2024
APP_EVOLUTION_INSTANCE=mira-prospect

# Prospecção automática (produção)
# Fixtures do fluxo de teste (4 pessoas fixas em toda busca). Ative apenas durante testes controlados.
APP_DISCOVERY_TEST_FIXTURES=false
# Com as fixtures, deixe FALSE para os e-mails irem aos endereços reais das 4 pessoas.
APP_OUTREACH_TEST_MODE=false
# APP_OUTREACH_TEST_EMAIL=  # só se APP_OUTREACH_TEST_MODE=true
APP_OUTREACH_WA_ENABLED=true
APP_OUTREACH_PRODUCT_URL=https://aerosuite.com.br
APP_OUTREACH_DEMO_URL=https://aerosuite.com.br/contato/#agendar-demo
