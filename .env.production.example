# Produção — mesmo host Vultr do Aero Suite (não commitar segredos).
# Copie para .env.production no servidor e ajuste as senhas.
#
# Pré-requisito: Evolution do Aero Suite já no ar
#   (docker-compose.production-evolution.yml → 127.0.0.1:18082)
# Instância WhatsApp conectada (ex.: aerosuite-default na tela Integração WhatsApp).

PROSPECT_DATA_ROOT=/var/mira

PUBLIC_BASE_URL=https://search.aerosuite.app
CORS_ALLOWED_ORIGINS=https://search.aerosuite.app,https://search.aerosuite.com.br

# SMTP — mesmas credenciais do AeroSuite (.env / .env.production)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=contato@aerosuite.com.br
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=noreply@aerosuite.com.br
APP_MAIL_FROM_NAME=Aero Suite
APP_MAIL_SUPPORT=contato@aerosuite.com.br

# Evolution no host (bind 127.0.0.1:18082 do container aerosuite-evolution-api)
# API MIRA rodando no host (JVM) → use 127.0.0.1
# API MIRA em Docker → use http://host.docker.internal:18082
#   ou junte a rede do AeroSuite (ver docker-compose.production.yml) e use
#   http://aerosuite-evolution-api:8080
APP_EVOLUTION_ENABLED=true
APP_EVOLUTION_API_BASE_URL=http://127.0.0.1:18082
APP_EVOLUTION_API_KEY=
APP_EVOLUTION_INSTANCE=aerosuite-default

# Prospecção automática (produção: contatos reais)
APP_OUTREACH_TEST_MODE=false
# APP_OUTREACH_TEST_EMAIL=
APP_OUTREACH_WA_ENABLED=true
APP_OUTREACH_PRODUCT_URL=https://aerosuite.com.br
APP_OUTREACH_DEMO_URL=https://aerosuite.com.br/contato/#agendar-demo
